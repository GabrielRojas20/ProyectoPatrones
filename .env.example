# Copiar a .env local; nunca subir el archivo real
Odoo__BaseUrl=http://localhost:8069
Odoo__Database=pos_demo
Odoo__ApiKey=replace-with-local-secret
Odoo__TimeoutSeconds=15
Auth__OperatorUsername=operator
Auth__OperatorPasswordHash=replace-with-pbkdf2-hash
Auth__JwtSecret=replace-with-at-least-32-characters
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5174
Cors__AllowedOrigins__2=http://localhost:5500
Idempotency__FilePath=data/idempotency.json
ASPNETCORE_URLS=http://localhost:8080
ODOO_POSTGRES_PASSWORD=change-this-local-password
ODOO_PORT=8069
