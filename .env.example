# Copiar a .env local; nunca subir el archivo real
Odoo__BaseUrl=http://localhost:8069
Odoo__Database=pos_demo
Odoo__Username=integration@example.com
Odoo__ApiKey=replace-with-local-secret
Odoo__TimeoutSeconds=10
